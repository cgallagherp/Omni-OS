# Supabase (local defaults are printed by `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. Used by the seed script, tests and platform-admin user provisioning.
# Never prefix with NEXT_PUBLIC_ and never import from client components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shows the demo sign-in shortcuts and the "Demonstration data" banner.
NEXT_PUBLIC_DEMO_MODE=true

# Brand (Omni orange). Placeholder until official brand values are supplied.
NEXT_PUBLIC_BRAND_PRIMARY=#F26A21

# Optional: enables AI narrative generation in the Assistant (phase 2).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

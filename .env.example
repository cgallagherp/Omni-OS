# Supabase (local defaults are printed by `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. Used by the seed script, tests and platform-admin user provisioning.
# Never prefix with NEXT_PUBLIC_ and never import from client components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shows the demo sign-in shortcuts and the "Demonstration data" banner.
NEXT_PUBLIC_DEMO_MODE=true

# Optional: enables AI narrative generation in the Assistant (phase 2).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Optional: Monday scorecard email delivery (Resend). Without these, scorecards are delivered in-app only.
RESEND_API_KEY=
EMAIL_FROM=

# Agents (worker: `npm run agents:worker`). The worker mints tokens for each company's agent
# principal with the project's JWT secret (local: printed by `npx supabase status`).
SUPABASE_JWT_SECRET=
# Long random secret; integration credentials are AES-256-GCM encrypted with a key derived from it. `openssl rand -hex 32`
AGENTS_ENCRYPTION_KEY=
AGENT_TICK_SECONDS=30
